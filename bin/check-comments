#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: check-comments [base] [-- pathspec...]"
  echo "Lists comment and docstring lines added since base (default: origin/HEAD, else origin/main)."
  echo "Exit 0 when clean, 1 when comments were added, 2 on error."
}

base=""
if [ $# -gt 0 ] && [ "$1" != "--" ]; then
  case "$1" in -h|--help) usage; exit 0 ;; esac
  base="$1"
  shift
fi
[ $# -gt 0 ] && [ "$1" = "--" ] && shift

if [ -z "$base" ]; then
  base="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
fi

if ! merge_base="$(git merge-base "$base" HEAD 2>/dev/null)"; then
  echo "check-comments: cannot find merge base with '$base'" >&2
  exit 2
fi

if [ $# -eq 0 ]; then
  set -- .
fi

git diff -U0 --no-color --no-ext-diff "$merge_base" -- "$@" \
  ':(exclude)*.md' ':(exclude)*.lock' ':(exclude)*.json' ':(exclude)*.svg' \
  ':(exclude)*.ipynb' ':(exclude)*.min.js' ':(exclude)**/vendor/**' ':(exclude)**/node_modules/**' \
| awk '
  function kind(path) {
    if (path ~ /\.py$/) return "py"
    if (path ~ /\.(js|jsx|ts|tsx|mjs|cjs|go|java|kt|kts|swift|dart|c|h|cc|cpp|hpp|rs|scala|php|css|scss|less)$/) return "c"
    if (path ~ /\.(sh|bash|zsh|fish|rb|pl|yml|yaml|toml|cfg|ini|conf|tf|hcl|nix|r)$/ || path ~ /(^|\/)(Dockerfile|Makefile|Tiltfile)[^\/]*$/) return "hash"
    if (path ~ /\.sql$/) return "sql"
    if (path ~ /\.(html|htm|vue|svelte|xml)$/) return "html"
    return ""
  }
  function kept(s) {
    return s ~ /^#!/ || s ~ /coding[:=]/ || s ~ /noqa|type:[[:space:]]*ignore|pragma|pylint:|fmt:[[:space:]]*(on|off|skip)|isort:|nosec|mypy:/ ||
      s ~ /eslint-disable|eslint-enable|prettier-ignore|@ts-expect-error|@ts-ignore|@ts-nocheck|istanbul ignore|c8 ignore|biome-ignore/ ||
      s ~ /\/\/go:|\/\/[[:space:]]*\+build|\/\/nolint|\/\/\/[[:space:]]*<reference|swiftlint:|\/\/[[:space:]]*ignore(_for_file)?:/ ||
      s ~ /SPDX-License|@license|Copyright|from __future__|Generated by Django|DO NOT EDIT|@generated|shellcheck/
  }
  function flag(text) {
    printf "%s:%d: %s\n", file, line, text
    hits++
  }
  /^diff --git / { file = ""; k = ""; in_doc = 0; in_str = 0; in_hunk = 0; next }
  !in_hunk && /^\+\+\+ / { file = substr($0, 5); sub(/^b\//, "", file); k = kind(file); next }
  !in_hunk && /^--- / { next }
  /^@@ / {
    split($3, a, ",")
    line = substr(a[1], 2) + 0
    in_hunk = 1
    in_doc = 0
    in_str = 0
    next
  }
  /^\+/ {
    text = substr($0, 2)
    s = text
    sub(/^[[:space:]]+/, "", s)
    if (k == "" || file == "") { line++; next }
    if (k == "py" && in_doc) {
      if (s != "") flag(text)
      if (s ~ /"""|\047\047\047/) in_doc = 0
      line++
      next
    }
    if (k == "py" && in_str) {
      if (s ~ /"""|\047\047\047/) in_str = 0
      line++
      next
    }
    if (kept(s)) { line++; next }
    hit = 0
    if (k == "py" || k == "hash") {
      if (s ~ /^#/ || text ~ /[[:space:]]#[[:space:]]/) hit = 1
      if (k == "hash" && file ~ /\.(tf|hcl)$/ && (s ~ /^\/\// || s ~ /^\/\*/)) hit = 1
    }
    if (k == "py" && s ~ /"""|\047\047\047/) {
      rest = s
      n = gsub(/"""|\047\047\047/, "", rest)
      if (s ~ /^[rbuRBU]?("""|\047\047\047)/) {
        hit = 1
        if (n == 1) in_doc = 1
      } else if (n == 1) {
        in_str = 1
      }
    }
    if (k == "c") {
      if (s ~ /^\/\// || s ~ /^\/\*/ || s ~ /^\*([[:space:]]|\/|$)/ || text ~ /[[:space:]]\/\/[[:space:]]/ || text ~ /\{\/\*/) hit = 1
    }
    if (k == "sql" && (s ~ /^--/ || text ~ /[[:space:]]--[[:space:]]/)) hit = 1
    if (k == "html" && (s ~ /<!--/ || s ~ /\{#/)) hit = 1
    if (hit) flag(text)
    line++
    next
  }
  END {
    if (hits > 0) {
      printf "\n%d comment or docstring line(s) added. Delete them, or rename and restructure until the code says it.\n", hits
      exit 1
    }
  }
'
